"""FastAPI application factory.

Run it with:

    uv run uvicorn {{ package_name }}.infrastructure.api.app:create_app --factory --reload
"""

from fastapi import FastAPI

from {{ package_name }}.infrastructure.api.errors import register_error_handlers
from {{ package_name }}.infrastructure.api.routes import health
from {{ package_name }}.infrastructure.config import Settings, get_settings


def create_app(settings: Settings | None = None) -> FastAPI:
    settings = settings or get_settings()
    app = FastAPI(
        title={{ project_name | tojson }},
        debug=settings.debug,
    )
    app.include_router(health.router)
    register_error_handlers(app)
    return app
