[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
{% if is_service %}
    "fastapi>=0.115",
    "pydantic-settings>=2.5",
    "uvicorn[standard]>=0.30",
{% endif %}
{% if is_ds %}
    "duckdb>=1.0",
    "pandas>=2.2",
    "pyarrow>=17",
{% endif %}
]
{% if is_cli %}

[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:main"
{% endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[dependency-groups]
dev = [
    "mypy>=1.11",
    "pytest>=8",
    "pytest-cov>=5",
    "ruff>=0.6",
{% if is_service %}
    "httpx2>=2.0",  # backend of Starlette/FastAPI TestClient
{% endif %}
{% if is_ds %}
    "ipykernel>=6",
    "nbstripout>=0.7",
    "pandas-stubs>=2.2",
{% endif %}
]

[tool.uv]
package = true

[tool.ruff]
line-length = 100
target-version = "{{ py_target }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "S", "C4", "SIM", "RUF"]
ignore = ["S101"]  # assert is fine in tests
{% if is_service %}

[tool.ruff.lint.flake8-bugbear]
extend-immutable-calls = ["fastapi.Depends", "fastapi.Query", "fastapi.Path", "fastapi.Body"]
{% endif %}

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S105", "S106", "S108", "S311", "S603", "S607"]
"scripts/**" = ["S603", "S607"]  # fixed-argv subprocess calls to git, no shell

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
files = ["src/{{ package_name }}"]
{% if is_ds %}

[[tool.mypy.overrides]]
module = ["duckdb.*", "pyarrow.*"]
ignore_missing_imports = true
{% endif %}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-m 'not live' --strict-markers"
markers = ["live: needs real external systems (cloud, network, credentials); skipped by default, run with -m live"]

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true
omit = ["*/__main__.py"]

[tool.coverage.report]
show_missing = true
skip_covered = true
fail_under = {{ min_coverage }}
